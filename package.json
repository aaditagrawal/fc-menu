{
  "name": "fc2-menus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:portless": "portless run",
    "build:menu-data": "bun scripts/build-menu-data.mjs",
    "build": "bun scripts/build-menu-data.mjs && next build && bun run typecheck",
    "start": "next start",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" \"!tools/oxlint/anti-slop/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" \"!tools/oxlint/anti-slop/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "typecheck": "bunx --bun tsrs --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/query-sync-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.89.0",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
