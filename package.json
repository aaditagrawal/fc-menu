{
  "name": "fc2-menus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:portless": "portless run",
    "build:menu-data": "bun scripts/build-menu-data.mjs",
    "build:og-image": "bun tools/og-image/render.mjs",
    "build": "bun scripts/build-menu-data.mjs && next build && bun run typecheck",
    "start": "next start",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" \"!tools/oxlint/anti-slop/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" \"!tools/oxlint/anti-slop/**\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "typecheck": "bunx --bun tsrs --noEmit",
    "test:security": "node scripts/security-braces.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/query-sync-storage-persister": "^5.108.4",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-persist-client": "^5.108.4",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.94.0",
    "@stylexjs/babel-plugin": "^0.19.2",
    "@stylexjs/postcss-plugin": "^0.19.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
